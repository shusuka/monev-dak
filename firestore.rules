rules_version = '2';

// Tempel isi berkas ini di Firebase Console → Firestore Database → Rules → Publish.
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │ WAJIB DIUBAH: ganti daftar ADMIN_EMAIL di bawah dengan email akun admin │
// │ yang Anda buat di Authentication → Users. Boleh lebih dari satu.        │
// └─────────────────────────────────────────────────────────────────────────┘
//
// Prinsip:
//  - Koleksi `hasil` boleh DIBACA siapa pun; papan peringkat peserta
//    memerlukannya. Isinya nama, daerah, nilai, dan waktu — tanpa email.
//  - Koleksi `peserta` memuat email, jadi hanya admin yang boleh membacanya.
//  - Hanya sesi terautentikasi yang boleh MENULIS.
//  - Dokumen `hasil` hanya boleh DIBUAT sekali; update dan delete ditolak,
//    sehingga peserta tidak dapat mengulang atau mengubah nilainya. Penghapusan
//    hanya mungkin dari Firebase Console.

service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmail() {
      return [
        'admin@emondak.go.id'      // ← GANTI dengan email admin Anda
      ];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in adminEmail();
    }

    match /peserta/{pid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120
        && request.resource.data.prov is string
        && request.resource.data.kab is string;
      allow delete: if false;
    }

    match /hasil/{hid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.pid is string
        && request.resource.data.tw == 2
        && (request.resource.data.kind == 'pre' || request.resource.data.kind == 'post')
        && request.resource.data.total == 20
        && request.resource.data.benar is int
        && request.resource.data.benar >= 0
        && request.resource.data.benar <= 20
        && request.resource.data.nilai == request.resource.data.benar * 5
        && request.resource.data.durasiMs is int
        && request.resource.data.durasiMs > 0
        && request.resource.data.durasiMs <= 1200000;

      // sekali kirim, nilai terkunci
      allow update, delete: if false;
    }

    // tutup koleksi lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
