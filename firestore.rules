rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// CARA MEMASANG
//   1. Buka https://console.firebase.google.com/u/0/project/emondak-faee8/firestore/rules
//   2. Hapus seluruh isi kotak teks di halaman itu.
//   3. Tempel seluruh isi berkas ini.
//   4. Ganti email pada fungsi adminEmail() di bawah dengan email admin Anda.
//   5. Klik tombol Publish.
// ═══════════════════════════════════════════════════════════════════════════
//
// Prinsip:
//  - Koleksi `hasil` boleh DIBACA siapa pun; papan peringkat peserta
//    memerlukannya. Isinya nama, daerah, nilai, dan waktu — tanpa email.
//  - Koleksi `peserta` memuat email, jadi hanya pemilik akunnya sendiri dan
//    admin yang boleh membacanya.
//  - Peserta hanya dapat menulis dokumen miliknya sendiri (dikunci oleh uid).
//  - Dokumen `hasil` hanya boleh DIBUAT sekali; update dan delete ditolak,
//    sehingga nilai tidak dapat diulang atau diubah. Penghapusan hanya
//    mungkin dari Firebase Console.

service cloud.firestore {
  match /databases/{database}/documents {

    // ┌───────────────────────────────────────────────────────────────────┐
    // │ GANTI baris email di bawah dengan email akun admin Anda.          │
    // │ Boleh lebih dari satu, pisahkan dengan koma:                      │
    // │     return ['satu@contoh.go.id', 'dua@contoh.go.id'];             │
    // └───────────────────────────────────────────────────────────────────┘
    function adminEmail() {
      return [
        'pfidbidangjalan@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in adminEmail();
    }

    // Petugas PFID: user id-nya (bagian email sebelum @) memuat kata "jalan",
    // misalnya ahmadjalan@... atau yolan_jalan@... Mereka penyusun berita acara
    // eMonitoring, bukan peserta yang dinilai.
    function idPfid() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('^[^@]*jalan[^@]*@.*');
    }

    // Sebagian petugas mendaftar dengan alamat kantor yang tidak memuat
    // "jalan", padahal namanya memuat. Aplikasi sudah menampilkan menunya
    // berdasarkan nama, jadi aturan ini mengikutinya: nama pada profil ikut
    // diperiksa supaya kunci API yang sama terpakai oleh mereka juga.
    function namaPfid() {
      return request.auth != null
        && exists(/databases/$(database)/documents/peserta/$(request.auth.uid))
        && get(/databases/$(database)/documents/peserta/$(request.auth.uid))
             .data.nama.lower().matches('.*jalan.*');
    }

    function isPfid() {
      return idPfid() || namaPfid();
    }

    match /peserta/{uid} {
      // pemilik akun boleh membaca profilnya sendiri; admin boleh membaca semua
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120
        && request.resource.data.prov is string
        && request.resource.data.kab is string;

      // admin boleh membersihkan akun yang dibuat sembarangan
      allow delete: if isAdmin();
    }

    match /hasil/{hid} {
      allow read: if true;

      allow create: if request.auth != null
        // hanya boleh menulis hasil milik sendiri, dan hanya pada id yang benar
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pid == request.auth.uid
        && (hid == request.auth.uid + '__tw2__pre' || hid == request.auth.uid + '__tw2__post')
        && request.resource.data.tw == 2
        && (request.resource.data.kind == 'pre' || request.resource.data.kind == 'post')
        && request.resource.data.total == 20
        && request.resource.data.benar is int
        && request.resource.data.benar >= 0
        && request.resource.data.benar <= 20
        && request.resource.data.nilai == request.resource.data.benar * 5
        && request.resource.data.durasiMs is int
        && request.resource.data.durasiMs > 0
        && request.resource.data.durasiMs <= 1200000;

      // sekali kirim, nilai terkunci bagi siapa pun
      allow update: if false;
      // hanya admin yang boleh menghapus, untuk membersihkan data sembarangan
      allow delete: if isAdmin();
    }

    // Konfigurasi gateway AI untuk berita acara eMonitoring. Kunci diisi sekali
    // oleh salah satu petugas PFID, lalu terpakai oleh semua petugas PFID di
    // perangkat mana pun. Peserta biasa tidak boleh membacanya.
    match /konfigurasi/{id} {
      allow read, write: if isPfid() || isAdmin();
    }

    // tutup koleksi lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
