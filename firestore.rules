rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// CARA MEMASANG
//   1. Buka https://console.firebase.google.com/u/0/project/emondak-faee8/firestore/rules
//   2. Hapus seluruh isi kotak teks di halaman itu.
//   3. Tempel seluruh isi berkas ini.
//   4. Ganti email pada fungsi adminEmail() di bawah dengan email admin Anda.
//   5. Klik tombol Publish.
// ═══════════════════════════════════════════════════════════════════════════
//
// Prinsip:
//  - Koleksi `hasil` boleh DIBACA siapa pun; papan peringkat peserta
//    memerlukannya. Isinya nama, daerah, nilai, dan waktu — tanpa email.
//  - Koleksi `peserta` memuat email, jadi hanya pemilik akunnya sendiri dan
//    admin yang boleh membacanya.
//  - Peserta hanya dapat menulis dokumen miliknya sendiri (dikunci oleh uid).
//  - Dokumen `hasil` hanya boleh DIBUAT sekali; update dan delete ditolak,
//    sehingga nilai tidak dapat diulang atau diubah. Penghapusan hanya
//    mungkin dari Firebase Console.

service cloud.firestore {
  match /databases/{database}/documents {

    // ┌───────────────────────────────────────────────────────────────────┐
    // │ GANTI baris email di bawah dengan email akun admin Anda.          │
    // │ Boleh lebih dari satu, pisahkan dengan koma:                      │
    // │     return ['satu@contoh.go.id', 'dua@contoh.go.id'];             │
    // └───────────────────────────────────────────────────────────────────┘
    function adminEmail() {
      return [
        'pfidbidangjalan@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in adminEmail();
    }

    // Petugas PFID: user id-nya (bagian email sebelum @) memuat kata "jalan",
    // misalnya ahmadjalan@... atau yolan_jalan@... Mereka penyusun berita acara
    // eMonitoring, bukan peserta yang dinilai.
    function idPfid() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('^[^@]*jalan[^@]*@.*');
    }

    // Sebagian petugas mendaftar dengan alamat kantor yang tidak memuat
    // "jalan", padahal namanya memuat. Aplikasi sudah menampilkan menunya
    // berdasarkan nama, jadi aturan ini mengikutinya: nama pada profil ikut
    // diperiksa supaya kunci API yang sama terpakai oleh mereka juga.
    function namaPfid() {
      return request.auth != null
        && exists(/databases/$(database)/documents/peserta/$(request.auth.uid))
        && get(/databases/$(database)/documents/peserta/$(request.auth.uid))
             .data.nama.lower().matches('.*jalan.*');
    }

    function isPfid() {
      return idPfid() || namaPfid();
    }

    function punyaProfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/peserta/$(request.auth.uid));
    }

    function profilSaya() {
      return get(/databases/$(database)/documents/peserta/$(request.auth.uid)).data;
    }

    // Kunci daerah peserta yang sedang masuk, mis. "magelang" atau
    // "kota-magelang". Diisi aplikasi saat mendaftar dan saat masuk.
    function kunciPeserta() {
      return punyaProfil() ? profilSaya().get('kunciKab', '') : '';
    }

    // Berita acara milik daerah pengguna sendiri. Kunci kosong tidak boleh
    // dianggap cocok dengan kunci kosong. Nama kabupaten/kota ikut
    // dibandingkan sebagai cadangan, untuk dokumen atau profil lama yang
    // belum sempat diisi kuncinya.
    function daerahSendiri(dok) {
      return punyaProfil() && (
        (dok.get('kunciDaerah', '') != '' && dok.get('kunciDaerah', '') == kunciPeserta())
        || (dok.get('kab', '') != '' && dok.get('kab', '').lower() == profilSaya().get('kab', '').lower())
      );
    }

    match /peserta/{uid} {
      // pemilik akun boleh membaca profilnya sendiri; admin boleh membaca semua
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120
        && request.resource.data.prov is string
        && request.resource.data.kab is string;

      // admin boleh membersihkan akun yang dibuat sembarangan
      allow delete: if isAdmin();
    }

    match /hasil/{hid} {
      allow read: if true;

      allow create: if request.auth != null
        // hanya boleh menulis hasil milik sendiri, dan hanya pada id yang benar.
        // Hanya triwulan yang sedang dibuka (TW III); TW II sudah ditutup,
        // nilainya tetap terbaca tetapi tidak bisa dikirim lagi.
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pid == request.auth.uid
        && (hid == request.auth.uid + '__tw3__pre' || hid == request.auth.uid + '__tw3__post')
        && request.resource.data.tw == 3
        && (request.resource.data.kind == 'pre' || request.resource.data.kind == 'post')
        && request.resource.data.total == 20
        && request.resource.data.benar is int
        && request.resource.data.benar >= 0
        && request.resource.data.benar <= 20
        && request.resource.data.nilai == request.resource.data.benar * 5
        && request.resource.data.durasiMs is int
        && request.resource.data.durasiMs > 0
        && request.resource.data.durasiMs <= 1200000;

      // sekali kirim, nilai terkunci bagi siapa pun
      allow update: if false;
      // hanya admin yang boleh menghapus, untuk membersihkan data sembarangan
      allow delete: if isAdmin();
    }

    // Konfigurasi gateway AI untuk berita acara eMonitoring. Kunci diisi sekali
    // oleh salah satu petugas PFID, lalu terpakai oleh semua petugas PFID di
    // perangkat mana pun. Peserta biasa tidak boleh membacanya.
    match /konfigurasi/{id} {
      allow read, write: if isPfid() || isAdmin();
    }

    // Arsip berita acara eMonitoring. Satu dokumen per daerah per tanggal,
    // isinya seluruh isian formulir; foto dokumentasinya ditaruh di subkoleksi
    // `foto` karena satu dokumen Firestore hanya muat 1 MB.
    //
    // Petugas PFID menyusun dan mengubah semuanya. Pemda hanya boleh MEMBACA,
    // dan hanya berita acara daerahnya sendiri — pemda Magelang tidak dapat
    // menyentuh dokumen Kabupaten Malang.
    //
    // Pemda TIDAK menelusuri koleksi ini: aturan yang bergantung pada isi
    // dokumen membuat Firestore menolak penelusuran, sekalipun kuerinya sudah
    // disaring. Daftar untuk pemda diambil dari /indeksDaerah di bawah, dan
    // koleksi ini hanya dibuka per dokumen saat dokumennya dibuka.
    match /beritaAcara/{id} {
      allow read: if isPfid() || isAdmin() || daerahSendiri(resource.data);
      allow write: if isPfid() || isAdmin();

      match /foto/{nomor} {
        allow read: if isPfid() || isAdmin()
          || daerahSendiri(get(/databases/$(database)/documents/beritaAcara/$(id)).data);
        allow write: if isPfid() || isAdmin();
      }
    }

    // Daftar berita acara per daerah. Nama dokumennya adalah kunci daerah,
    // mis. `magelang`, dan isinya hanya ringkasan (daerah, tanggal, penyusun,
    // jumlah ruas) — tanpa isi notulensi. Pemda membaca SATU dokumen yang
    // namanya sama dengan kunci daerahnya sendiri, jadi izinnya tidak
    // bergantung pada isi dokumen dan tidak mungkin bocor ke daerah lain.
    match /indeksDaerah/{kunci} {
      allow read: if isPfid() || isAdmin()
        || (kunci != '' && kunci == kunciPeserta());
      allow write: if isPfid() || isAdmin();
    }

    // Survei kepuasan pemerintah daerah. Satu dokumen per akun, dinamai uid
    // pemiliknya: pemda hanya bisa menulis dan membaca penilaiannya sendiri,
    // sedangkan admin membaca semuanya untuk direkap dan diunduh ke Excel.
    // Penilaian tidak bisa saling dilihat antar pemda.
    //
    // Admin juga boleh MENULIS dokumen milik id lain — satu-satunya jalan
    // memasukkan jawaban yang terlanjur diisi lewat Google Formulir putaran
    // pertama. Sebagian pengisinya tidak punya akun sama sekali, jadi
    // dokumennya dinamai `gform-…`, bukan uid Authentication. Kelonggaran ini
    // hanya di koleksi survei: `hasil` tetap tidak bisa ditulis siapa pun
    // selain pemiliknya, supaya nilai test tidak bisa dititipkan.
    // Survei ini milik Rakor TW II yang sudah ditutup: pemda masih boleh
    // membaca penilaiannya sendiri, tetapi hanya admin yang boleh menulis.
    match /survei/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Progres pelaporan tiap daerah di aplikasi eMonitoring. Angkanya tidak
    // bisa diambil sendiri oleh aplikasi ini, jadi admin mengunggahnya secara
    // berkala dari berkas .xlsx atau .csv; satu dokumen per daerah, dinamai
    // kunci daerahnya (mis. `magelang`) supaya unggahan berikutnya menimpa
    // baris yang sama, bukan menumpuk.
    //
    // Isinya angka progres, nama kontak, dan nomor telepon yang dipakai
    // menagih lewat WhatsApp — bukan data yang boleh dibaca pemda, karena
    // memuat nomor daerah lain. Hanya admin dan petugas PFID yang membacanya.
    match /emonitoring/{kunci} {
      allow read, write: if isAdmin() || isPfid();
    }

    // Daftar nama akun pemda per daerah, untuk halaman masuk: pemda memilih
    // provinsi, kabupaten, lalu namanya, dan cukup mengetik kata sandi.
    // Halaman masuk dibuka sebelum ada sesi, jadi koleksi ini harus terbuka
    // untuk dibaca. Isinya nama dan email akun saja — tanpa nilai, jawaban,
    // atau nomor telepon. Tiap akun hanya boleh menulis barisnya sendiri;
    // admin menyusun ulang seluruhnya dari koleksi `peserta`.
    match /akunDaerah/{kunci}/akun/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            && request.resource.data.uid == uid
            && kunci == kunciPeserta());
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Konfirmasi data ruas Triwulan III. Satu dokumen per daerah, dinamai
    // kunci daerahnya. Pemda menulis jawabannya sendiri di konfirmasiTw3;
    // petugas PFID dan admin menulis putusannya di verifikasiTw3. Dipisah
    // supaya pemda tidak bisa mengubah hasil verifikasi, dan pusat tidak
    // menimpa jawaban pemda. Pemda hanya membaca dokumen daerahnya sendiri.
    match /konfirmasiTw3/{kunci} {
      allow read: if isPfid() || isAdmin() || (kunci != '' && kunci == kunciPeserta());
      allow write: if isAdmin() || (kunci != '' && kunci == kunciPeserta() && !isPfid());
    }
    match /verifikasiTw3/{kunci} {
      allow read: if isPfid() || isAdmin() || (kunci != '' && kunci == kunciPeserta());
      allow write: if isPfid() || isAdmin();
    }

    // tutup koleksi lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
